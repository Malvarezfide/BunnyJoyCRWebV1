{
  "name": "bunnyjoycr",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "npm run build --prefix frontend",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute bunnyjoycr_db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute bunnyjoycr_db --remote --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^4.107.0"
  }
}
